awarded\"><rect x=\"220\" y=\"845\" width=\"150\" height=\"65\" rx=\"6\" class=\"n-grn\"/><text x=\"295\" y=\"862\" class=\"fts\">Log transaction</text><text x=\"295\" y=\"875\" class=\"fts\">in CIS & grant</text><text x=\"295\" y=\"888\" class=\"fts\" style=\"font-weight:700;\">Gold Membership</text><text x=\"295\" y=\"901\" class=\"fts\">points</text></g>\n            <g class=\"fn\" data-tip=\"Transaction complete — rental fulfilled successfully!\"><ellipse cx=\"295\" cy=\"966\" rx=\"48\" ry=\"18\" class=\"n-oval\"/><text x=\"295\" y=\"966\" class=\"ft\" style=\"font-weight:700;\">END</text></g>\n            <!-- Right branch -->\n            <g class=\"fn\" data-tip=\"Out-of-stock: CIS auto-issues a free rental coupon\"><rect x=\"424\" y=\"244\" width=\"128\" height=\"64\" rx=\"6\" class=\"n-gray\"/><text x=\"488\" y=\"262\" class=\"fts\">Apply Stock</text><text x=\"488\" y=\"274\" class=\"fts\">Guarantee:</text><text x=\"488\" y=\"286\" class=\"fts\">Issue free</text><text x=\"488\" y=\"298\" class=\"fts\">rental coupon</text></g>\n            <g class=\"fn\" data-tip=\"Customer notified with restock ETAs and suggested alternatives\"><rect x=\"424\" y=\"340\" width=\"128\" height=\"52\" rx=\"6\" class=\"n-gray\"/><text x=\"488\" y=\"358\" class=\"fts\">Notify available</text><text x=\"488\" y=\"371\" class=\"fts\">ETAs & Suggest</text><text x=\"488\" y=\"384\" class=\"fts\">key Titles</text></g>\n            <g class=\"fn\" data-tip=\"Out-of-stock flow complete — coupon issued\"><ellipse cx=\"488\" cy=\"442\" rx=\"40\" ry=\"16\" class=\"n-oval\"/><text x=\"488\" y=\"442\" class=\"ft\" style=\"font-weight:700;\">END</text></g>\n          </svg>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Presenter -->\n  <div class=\"flex justify-end flex-shrink-0\">\n    <div class=\"badge flex items-center gap-1.5\">\n      <svg width=\"13\" height=\"13\" fill=\"none\" viewBox=\"0 0 24 24\"><path d=\"M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2M12 11a4 4 0 100-8 4 4 0 000 8z\" stroke=\"#FFD100\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n      <span class=\"y\">Jhoan Steven Murillo Garcia</span>\n    </div>\n  </div>\n</div>\n</section>\n\n<!-- ═══════════════════ SLIDE 4 · EXPECTED RESULTS ═══════════════════ -->\n<section id=\"s4\" class=\"slide\">\n<div class=\"px-5 md:px-10 py-5 flex flex-col gap-4 h-full\">\n\n  <!-- Header -->\n  <div>\n    <div class=\"flex items-center gap-2 mb-0.5\">\n      <span class=\"inline-flex items-center justify-center w-6 h-6 rounded-full text-[10px] font-bold\"\n        style=\"background:rgba(255,209,0,.13);color:#FFD100;border:1px solid rgba(255,209,0,.28);\">4</span>\n      <span class=\"text-[10px] font-bold tracking-[.18em]\" style=\"color:rgba(255,209,0,.5);\">1.1.4 · EXPECTED RESULTS & IMPACT</span>\n    </div>\n    <h2 class=\"text-[22px] md:text-[28px] font-extrabold tracking-tight text-white\">\n      Measurable <span class=\"y\">Business Impact</span>\n    </h2>\n  </div>\n\n  <!-- Impact Cards -->\n  <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4 flex-1\">\n    <!-- Speeds Up -->\n    <div class=\"icard flex flex-col\">\n      <div class=\"w-11 h-11 rounded-xl flex items-center justify-center mb-4\" style=\"background:linear-gradient(135deg,rgba(255,209,0,.14),rgba(255,209,0,.04));border:1px solid rgba(255,209,0,.18);\">\n        <svg width=\"22\" height=\"22\" fill=\"none\" viewBox=\"0 0 24 24\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\" stroke=\"#FFD100\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </div>\n      <h3 class=\"text-base font-extrabold y mb-2\">Speeds Up</h3>\n      <p class=\"text-[13px] leading-relaxed flex-1\" style=\"color:rgba(220,220,230,.78);\">\n        The system <span class=\"y font-semibold\">speeds up</span> tape return processing, barcode scanning, and instant cloud streaming authorization.\n      </p>\n      <div class=\"flex gap-1.5 mt-3\"><span class=\"gtag\">GRAMMAR: 'speeds up'</span></div>\n    </div>\n\n    <!-- Improves -->\n    <div class=\"icard flex flex-col\">\n      <div class=\"w-11 h-11 rounded-xl flex items-center justify-center mb-4\" style=\"background:linear-gradient(135deg,rgba(96,165,250,.14),rgba(96,165,250,.04));border:1px solid rgba(96,165,250,.18);\">\n        <svg width=\"22\" height=\"22\" fill=\"none\" viewBox=\"0 0 24 24\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\" stroke=\"#60A5FA\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </div>\n      <h3 class=\"text-base font-extrabold blu mb-2\">Improves</h3>\n      <p class=\"text-[13px] leading-relaxed flex-1\" style=\"color:rgba(220,220,230,.78);\">\n        It <span class=\"blu font-semibold\">improves</span> customer retention, service quality, and Gold Membership rewards.\n      </p>\n      <div class=\"flex gap-1.5 mt-3\"><span class=\"gtag\">GRAMMAR: 'improves'</span></div>\n    </div>\n\n    <!-- Secures -->\n    <div class=\"icard flex flex-col\">\n      <div class=\"w-11 h-11 rounded-xl flex items-center justify-center mb-4\" style=\"background:linear-gradient(135deg,rgba(52,211,153,.14),rgba(52,211,153,.04));border:1px solid rgba(52,211,153,.18);\">\n        <svg width=\"22\" height=\"22\" fill=\"none\" viewBox=\"0 0 24 24\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\" stroke=\"#34D399\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </div>\n      <h3 class=\"text-base font-extrabold grn mb-2\">Secures</h3>\n      <p class=\"text-[13px] leading-relaxed flex-1\" style=\"color:rgba(220,220,230,.78);\">\n        It <span class=\"grn font-semibold\">secures</span> transaction records, financial data, and digital preservation archives.\n      </p>\n      <div class=\"flex gap-1.5 mt-3\"><span class=\"gtag\">GRAMMAR: 'secures'</span></div>\n    </div>\n  </div>\n\n  <!-- Closing Banner -->\n  <div class=\"rounded-xl p-5\" style=\"background:linear-gradient(135deg,rgba(255,209,0,.08),rgba(255,209,0,.02));border:1px solid rgba(255,209,0,.18);\">\n    <p class=\"text-[13px] md:text-[14px] text-center leading-relaxed\" style=\"color:rgba(235,235,240,.82);\">\n      <span class=\"y font-bold\">\"</span>In conclusion, our software provides the <span class=\"text-white font-semibold\">reliable infrastructure</span> required to keep the company <span class=\"y font-bold\">competitive</span> and <span class=\"y font-bold\">profitable</span>. Thank you for your attention!<span class=\"y font-bold\">\"</span>\n    </p>\n  </div>\n\n  <!-- Team Footer + Presenter -->\n  <div class=\"flex flex-col md:flex-row items-center justify-between gap-3\">\n    <div class=\"flex items-center gap-2 text-[11px] flex-wrap\" style=\"color:rgba(180,180,195,.45);\">\n      <span class=\"tracking-widest font-semibold\">DEVELOPMENT TEAM</span>\n      <span style=\"color:rgba(255,209,0,.25);\">|</span>\n      <span style=\"color:rgba(220,220,230,.6);\">Maria Fernanda Huertas Montes</span>\n      <span style=\"color:rgba(255,209,0,.18);\">·</span>\n      <span style=\"color:rgba(220,220,230,.6);\">Juan Camilo Valencia Rey</span>\n      <span style=\"color:rgba(255,209,0,.18);\">·</span>\n      <span style=\"color:rgba(220,220,230,.6);\">Jhoan Steven Murillo Garcia</span>\n      <span style=\"color:rgba(255,209,0,.18);\">·</span>\n      <span style=\"color:rgba(220,220,230,.6);\">Valeria Becerra Giraldo</span>\n    </div>\n    <div class=\"badge flex items-center gap-1.5\">\n      <svg width=\"13\" height=\"13\" fill=\"none\" viewBox=\"0 0 24 24\"><path d=\"M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2M12 11a4 4 0 100-8 4 4 0 000 8z\" stroke=\"#FFD100\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n      <span class=\"y\">Valeria Becerra Giraldo</span>\n    </div>\n  </div>\n</div>\n</section>\n\n</main>\n\n<!-- ══════════════ BOTTOM NAV ══════════════ -->\n<nav class=\"fixed bottom-0 inset-x-0 z-40 flex items-center justify-between px-5 py-2.5\"\n  style=\"background:linear-gradient(0deg,#0A0E1A 65%,transparent);\">\n  <button id=\"bp\" class=\"nbtn\" onclick=\"prev()\" disabled>← PREV</button>\n  <div class=\"flex items-center gap-2\">\n    <div class=\"dot on\" onclick=\"go(0)\"></div>\n    <div class=\"dot\" onclick=\"go(1)\"></div>\n    <div class=\"dot\" onclick=\"go(2)\"></div>\n    <div class=\"dot\" onclick=\"go(3)\"></div>\n  </div>\n  <button id=\"bn\" class=\"nbtn\" onclick=\"next()\">NEXT →</button>\n</nav>\n\n<!-- Tooltip -->\n<div id=\"tip\"></div>\n\n<script>\n  // ─── Slide Navigation ───\n  let cur=0; const N=4;\n  const sl=document.querySelectorAll('.slide'),\n        dt=document.querySelectorAll('.dot'),\n        bp=document.getElementById('bp'),\n        bn=document.getElementById('bn'),\n        id=document.getElementById('ind');\n\n  function go(i){\n    if(i<0||i>=N||i===cur) return;\n    const d=i>cur?1:-1;\n    sl[cur].classList.remove('active');\n    sl[cur].style.transform=d>0?'translateX(-50px)':'translateX(50px)';\n    sl[cur].style.opacity='0'; sl[cur].style.pointerEvents='none';\n    cur=i;\n    sl[cur].style.transform=d>0?'translateX(50px)':'translateX(-50px)';\n    sl[cur].style.opacity='0';\n    requestAnimationFrame(()=>requestAnimationFrame(()=>{\n      sl[cur].classList.add('active');\n      sl[cur].style.transform='translateX(0)'; sl[cur].style.opacity='1'; sl[cur].style.pointerEvents='auto';\n    }));\n    dt.forEach((d,j)=>d.classList.toggle('on',j===cur));\n    bp.disabled=cur===0; bn.disabled=cur===N-1;\n    id.textContent=`SLIDE ${cur+1} / ${N}`;\n  }\n  function next(){go(cur+1)} function prev(){go(cur-1)}\n  document.addEventListener('keydown',e=>{\n    if(e.key==='ArrowRight'||e.key===' '){e.preventDefault();next()}\n    if(e.key==='ArrowLeft'){e.preventDefault();prev()}\n  });\n\n  // ─── Flowchart Zoom ───\n  let cs=1; const cz=document.getElementById('cz');\n  function zc(d){cs=Math.max(.5,Math.min(2,cs+d));cz.style.transform=`scale(${cs})`}\n  function rc(){cs=1;cz.style.transform='scale(1)'}\n\n  // ─── Tooltip ───\n  const tp=document.getElementById('tip');\n  document.querySelectorAll('.fn').forEach(n=>{\n    const t=n.getAttribute('data-tip'); if(!t) return;\n    n.addEventListener('mouseenter',()=>{tp.textContent=t;tp.classList.add('v');});\n    n.addEventListener('mousemove',e=>{tp.style.left=(e.clientX+14)+'px';tp.style.top=(e.clientY-28)+'px';});\n    n.addEventListener('mouseleave',()=>{tp.classList.remove('v');});\n  });\n</script>\n</body>\n</html>\n","Description":"Definitive 4-slide Blockbuster Digital CIS presentation following the exact Technical Pitch PDF template structure, with grammar/vocabulary callouts, exact content text, presenter badges, SVG flowchart, and full navigation.","Overwrite":false,"TargetFile":"C:\\Users\\vbece\\.gemini\\antigravity\\brain\\7fa0148b-a93f-4f73-bebb-ee8e1145f293\\blockbuster_cis_technical_pitch.html","toolAction":"Creating technical pitch presentation","toolSummary":"Technical Pitch presentation"}}]}
