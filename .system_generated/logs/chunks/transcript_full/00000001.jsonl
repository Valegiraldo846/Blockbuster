px)';\n    slides[currentSlide].style.opacity = '0';\n    slides[currentSlide].style.pointerEvents = 'none';\n\n    // Enter new\n    currentSlide = index;\n    slides[currentSlide].style.transform = dir > 0 ? 'translateX(60px)' : 'translateX(-60px)';\n    slides[currentSlide].style.opacity = '0';\n\n    requestAnimationFrame(() => {\n      requestAnimationFrame(() => {\n        slides[currentSlide].classList.add('active');\n        slides[currentSlide].style.transform = 'translateX(0)';\n        slides[currentSlide].style.opacity = '1';\n        slides[currentSlide].style.pointerEvents = 'auto';\n      });\n    });\n\n    // Update dots\n    dots.forEach((d, i) => d.classList.toggle('active', i === currentSlide));\n\n    // Update buttons\n    btnPrev.disabled = currentSlide === 0;\n    btnNext.disabled = currentSlide === totalSlides - 1;\n\n    // Update indicator\n    indicator.textContent = `SLIDE ${currentSlide + 1} / ${totalSlides}`;\n  }\n\n  function nextSlide() { goToSlide(currentSlide + 1); }\n  function prevSlide() { goToSlide(currentSlide - 1); }\n\n  // Keyboard nav\n  document.addEventListener('keydown', (e) => {\n    if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); nextSlide(); }\n    if (e.key === 'ArrowLeft') { e.preventDefault(); prevSlide(); }\n  });\n\n  // ===== FLOWCHART ZOOM =====\n  let chartScale = 1;\n  const chartZoom = document.getElementById('chart-zoom');\n  function zoomChart(delta) {\n    chartScale = Math.max(0.5, Math.min(2.0, chartScale + delta));\n    chartZoom.style.transform = `scale(${chartScale})`;\n  }\n  function resetChart() { chartScale = 1; chartZoom.style.transform = 'scale(1)'; }\n\n  // ===== TOOLTIP =====\n  const tooltip = document.getElementById('tooltip');\n  document.querySelectorAll('.fc-node').forEach(node => {\n    const tip = node.getAttribute('data-tip');\n    if (!tip) return;\n    node.addEventListener('mouseenter', () => { tooltip.textContent = tip; tooltip.classList.add('visible'); });\n    node.addEventListener('mousemove', (e) => { tooltip.style.left = (e.clientX + 14) + 'px'; tooltip.style.top = (e.clientY - 28) + 'px'; });\n    node.addEventListener('mouseleave', () => { tooltip.classList.remove('visible'); });\n  });\n</script>\n</body>\n</html>\n","Description":"Full 4-slide Blockbuster Digital CIS web presentation with dark navy theme, CRT scanline effects, navigation controls, and an SVG flowchart on Slide 3 replicating the uploaded image.","Overwrite":false,"TargetFile":"C:\\Users\\vbece\\.gemini\\antigravity\\brain\\7fa0148b-a93f-4f73-bebb-ee8e1145f293\\blockbuster_digital_cis_presentation.html","toolAction":"Creating full presentation","toolSummary":"Blockbuster CIS 4-slide presentation"}}]}
